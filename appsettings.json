{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppConfig": "Endpoint=https://<your-app-config-name>.azconfig.io;Id=<id>;Secret=<secret>"
  },
  "FeatureManagement": {
    "AzureDevOpsWriteOperations": true,
    "UserGroupManagement": false,
    "WorkItemCreation": false,
    "WorkItemUpdate": false,
    "WorkItemDeletion": false,
    "WorkItemQuery": false
  },
  "AzureDevOps": {
    "Organization": "__Organization__",
    "PAT": "__PAT__"
  }
}


